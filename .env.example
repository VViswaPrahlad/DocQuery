# Canonical provider names; legacy GROK_* names are also supported.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
USE_HYBRID_SEARCH=true
OCR_FALLBACK=true
SUMMARY_BATCH_CHARS=10000
MULTI_DOC_MIN_COSINE=0.35
# Use 1 after downloading the embedding model to prevent network lookups.
HF_HUB_OFFLINE=0
